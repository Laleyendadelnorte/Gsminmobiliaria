# Copy to .env.local for a local Node installation. No real secrets belong here.
DATABASE_URL=postgresql://gcm:REPLACE_DATABASE_PASSWORD@127.0.0.1:5432/gcm
APP_URL=http://localhost:3000
SESSION_SECRET=REPLACE_WITH_48_RANDOM_BYTES
NODE_ENV=development
NEXT_TELEMETRY_DISABLED=1
BOOTSTRAP_EMAIL=your-admin@example.com
BOOTSTRAP_PASSWORD=REPLACE_WITH_A_RANDOM_PASSWORD_AT_LEAST_16_CHARACTERS
BOOTSTRAP_NAME=Administrador GCM
ENABLE_BOOTSTRAP_ACCESS=false
BOOTSTRAP_TOKEN_HASH=
ALLOW_DEMO_SEED=false
# A server-held real key activates the AI provider. Empty means explicit deterministic mode.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-6.1-terra
PAYMENT_MODE=sandbox
WEBHOOK_SECRET=REPLACE_WITH_48_RANDOM_BYTES
# Optional S3-compatible private storage. Empty S3_ENDPOINT uses .storage/.
MEDIA_ROOT=
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=gcm
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Docker Compose requires these in .env; do not use sample passwords.
POSTGRES_PASSWORD=
# Optional operator commands; leave blank until explicitly needed.
RESET_EMAIL=
RESET_PASSWORD=
AGE_RECIPIENT=
AGE_IDENTITY_FILE=
RESTORE_DATABASE_URL=
# Tests use a separate disposable database; never enable against production.
RUN_BACKEND_INTEGRATION=false
AI_INTEGRATION_TEST=0
MEDIA_INTEGRATION_TEST=0
LOAD_TEST=0
GCM_ACCESS_URL=
BROWSER_PROXY=
CHROMIUM_PATH=/usr/bin/chromium
