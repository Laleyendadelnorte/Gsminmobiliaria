    "assets": "bash scripts/fetch-demo-assets.sh && tsx scripts/optimize-demo-assets.ts",
    "reset-password": "tsx scripts/reset-password.ts",
    "backup": "bash scripts/backup.sh",
    "restore": "bash scripts/restore.sh",
